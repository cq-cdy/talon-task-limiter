cmake_minimum_required(VERSION 3.20)
foreach(required IN ITEMS SOURCE_DIR BINARY_DIR CXX_COMPILER)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
if(NOT EXISTS "${BINARY_DIR}/include/talon/task_limiter/export.h")
  message(FATAL_ERROR "The task limiter must be configured first")
endif()

set(directory "${BINARY_DIR}/macro-odr")
file(MAKE_DIRECTORY "${directory}")
set(prefix "")
foreach(index RANGE 0 31)
  string(APPEND prefix "enum { burn_${index} = __COUNTER__ };\n")
endforeach()
set(body "#include \"talon/concurrent_task_limiter.h\"\nint talon_task_limiter_macro_probe_end;\n")
file(WRITE "${directory}/plain.cc" "${body}")
file(WRITE "${directory}/shifted.cc" "${prefix}${body}")

separate_arguments(flags NATIVE_COMMAND "${CXX_FLAGS}")
if(MSVC_MODE)
  list(APPEND flags /nologo /TP /EP "/std:c++${STANDARD}" /Zc:preprocessor)
  set(include_flag /I)
  set(define_flag /D)
else()
  list(APPEND flags -E -P "-std=c++${STANDARD}")
  set(include_flag -I)
  set(define_flag -D)
  if(SYSROOT)
    list(APPEND flags "--sysroot=${SYSROOT}")
  endif()
  if(OSX_SYSROOT)
    list(APPEND flags -isysroot "${OSX_SYSROOT}")
  endif()
endif()
foreach(include IN ITEMS "${SOURCE_DIR}/include" "${BINARY_DIR}/include")
  list(APPEND flags "${include_flag}${include}")
endforeach()
foreach(include IN LISTS STATUS_INCLUDES)
  list(APPEND flags "${include_flag}${include}")
endforeach()
foreach(definition IN LISTS STATUS_DEFINITIONS)
  list(APPEND flags "${define_flag}${definition}")
endforeach()
list(APPEND flags "${define_flag}TALON_TASK_LIMITER_STATIC_DEFINE"
  "${define_flag}TALON_STATUS_USE_LINE_COUNTER=1")

foreach(mode IN ITEMS plain shifted)
  execute_process(COMMAND "${CXX_COMPILER}" ${flags} "${directory}/${mode}.cc"
    RESULT_VARIABLE result OUTPUT_VARIABLE preprocessed ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Preprocessing failed: ${error}")
  endif()
  file(WRITE "${directory}/${mode}.ii" "${preprocessed}")
  string(FIND "${preprocessed}" "class ConcurrentTaskLimiter final" begin)
  string(FIND "${preprocessed}" "int talon_task_limiter_macro_probe_end" end)
  if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "Cannot locate the complete public class definition")
  endif()
  math(EXPR length "${end} - ${begin}")
  string(SUBSTRING "${preprocessed}" ${begin} ${length} definition_${mode})
endforeach()
if(NOT definition_plain STREQUAL definition_shifted)
  message(FATAL_ERROR "Public inline/template definition depends on __COUNTER__ history")
endif()
message(STATUS "Public class tokens are identical after 32 prior __COUNTER__ expansions")
